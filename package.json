{
  "name": "make-model-dropdown",
  "version": "0.6.0",
  "description": "Year, make and model dropdown for cars, motorcycles, vans and trucks: a dependency-free vehicle selector (YMM) on open data from official registers.",
  "keywords": [
    "year-make-model",
    "year make model",
    "ymm",
    "vehicle-selector",
    "car-make-model",
    "make-model-year",
    "vehicle-dropdown",
    "car-dropdown",
    "car make model dropdown",
    "motorcycle make model dropdown",
    "motorbike dropdown",
    "truck makes and models",
    "vehicle dropdown",
    "make model select",
    "car makes and models list",
    "vehicle data",
    "car database",
    "motorcycle database",
    "truck database",
    "vehicles api",
    "vehiclesdb"
  ],
  "homepage": "https://vehiclesdb.com/make-and-model-dropdown",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vehiclesdb/make-model-dropdown.git"
  },
  "bugs": "https://github.com/vehiclesdb/make-model-dropdown/issues",
  "license": "MIT",
  "scripts": {
    "test": "node --test",
    "build": "node scripts/build-esm.js && node scripts/build-min.js",
    "build:esm": "node scripts/build-esm.js",
    "build:min": "node scripts/build-min.js",
    "prepublishOnly": "node scripts/build-esm.js --check && node scripts/build-min.js --check"
  },
  "main": "make-model-dropdown.js",
  "module": "make-model-dropdown.mjs",
  "exports": {
    ".": {
      "import": "./make-model-dropdown.mjs",
      "require": "./make-model-dropdown.js",
      "default": "./make-model-dropdown.js"
    },
    "./make-model-dropdown.mjs": "./make-model-dropdown.mjs",
    "./make-model-dropdown.js": "./make-model-dropdown.js",
    "./make-model-dropdown.min.js": "./make-model-dropdown.min.js",
    "./index.mjs": "./index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "make-model-dropdown.js",
    "make-model-dropdown.min.js",
    "make-model-dropdown.mjs",
    "index.mjs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": true,
  "devDependencies": {
    "jsdom": "^31.0.0",
    "terser": "5.51.2"
  }
}
