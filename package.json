{
  "name": "make-model-dropdown",
  "version": "0.4.0",
  "description": "Car make and model dropdown for any web page. A dependent make/model picker with vehicle data from VehiclesDB: live from the API with a publishable key, or keyless from the open dataset. 14,000+ models, 850+ makes, cars and motorcycles to trucks and buses, from official national vehicle registers. Zero dependencies.",
  "keywords": [
    "car make model dropdown",
    "motorcycle make model dropdown",
    "motorbike dropdown",
    "truck makes and models",
    "vehicle dropdown",
    "make model select",
    "car makes and models list",
    "vehicle data",
    "car database",
    "motorcycle database",
    "truck database",
    "vehicles api",
    "vehiclesdb"
  ],
  "homepage": "https://vehiclesdb.com/make-and-model-dropdown",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vehiclesdb/make-model-dropdown.git"
  },
  "bugs": "https://github.com/vehiclesdb/make-model-dropdown/issues",
  "license": "MIT",
  "scripts": {
    "test": "node --test",
    "build:esm": "node scripts/build-esm.js",
    "prepublishOnly": "node scripts/build-esm.js --check"
  },
  "main": "make-model-dropdown.js",
  "module": "make-model-dropdown.mjs",
  "exports": {
    ".": {
      "import": "./make-model-dropdown.mjs",
      "require": "./make-model-dropdown.js",
      "default": "./make-model-dropdown.js"
    },
    "./make-model-dropdown.mjs": "./make-model-dropdown.mjs",
    "./make-model-dropdown.js": "./make-model-dropdown.js",
    "./index.mjs": "./index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "make-model-dropdown.js",
    "make-model-dropdown.mjs",
    "index.mjs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": true,
  "devDependencies": {
    "jsdom": "^26.1.0"
  }
}
